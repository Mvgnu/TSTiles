{
  "name": "tilesserver",
  "private": true,
  "type": "commonjs",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domains",
    "test:domains": "vitest run src/domains --globals --passWithNoTests",
    "demo:start": "npm run build && node dist/app/demo-server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.3.0",
    "eslint": "^9.39.3",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
