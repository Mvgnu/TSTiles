{
  "name": "tstiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prepare and self-host existing PMTiles archives for MapLibre websites.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "build": "node scripts/build.mjs",
    "test": "vitest run test/archive test/web",
    "test:archive": "vitest run test/archive",
    "test:web": "vitest run test/web",
    "test:architecture": "node --test test/architecture/*.test.mjs",
    "test:hosting": "node --test test/hosting/*.test.mjs",
    "archive:inspect": "node dist/archive/cli.js inspect",
    "archive:publish": "node dist/archive/cli.js publish",
    "demo:prepare": "node scripts/prepare-demo.mjs",
    "scope:check": "node scripts/check-scope.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.15.0",
    "pmtiles": "4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.3",
    "globals": "^17.4.0",
    "playwright": "1.58.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  }
}
